{
  "name": "@servrox/console-fx-react",
  "version": "0.2.0",
  "description": "React hooks, an opt-in banner, and honest previews for ConsoleFX.",
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/servrox/console-fx.git",
    "directory": "packages/console-fx-react"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "peerDependencies": {
    "react": "^19.0.0"
  },
  "dependencies": {
    "@servrox/console-fx": "workspace:^"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "engines": {
    "node": ">=24.15.0 <25"
  }
}
